# Copy this file to ".env" (same folder) and fill in the real values.
# NEVER commit ".env" itself - only this ".env.example" template belongs in git.

# --- Incident Retrieval feature (Gemini) ---
# Get this key from https://aistudio.google.com
GEMINI_API_KEY=

# Model name to use for query expansion (fill in once you've picked one from Google's docs)
GEMINI_MODEL=

# --- Secure Snapshot Sync feature (Tink) ---
# Path to the local Tink keyset file generated in SETUP.md step 4.
# This path is fine to commit (it's just a path); the keyset FILE itself must never be committed.
TINK_KEYSET_PATH=.tink_keyset.json

# Snapshot sync demo identifiers (used in associated-data binding, see spec section 6.2)
DEMO_MISSION_ID=
DEMO_SATELLITE_ID=
